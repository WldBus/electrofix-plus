@model PagerModel
@* подвал списка: сколько всего записей и переход по страницам *@
@{
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.Pages, Model.Page + 2);
    string Url(int page) => ListUrl.With(Context.Request, ("page", page == 1 ? null : page));
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-top small">
    <span class="text-muted">Всего записей: @Model.Total</span>
    @if (Model.Pages > 1)
    {
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page - 1)">‹</a></li>
            @if (from > 1)
            {
                <li class="page-item"><a class="page-link" href="@Url(1)">1</a></li>
                <li class="page-item disabled"><span class="page-link">…</span></li>
            }
            @for (var p = from; p <= to; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Url(p)">@p</a></li>
            }
            @if (to < Model.Pages)
            {
                <li class="page-item disabled"><span class="page-link">…</span></li>
                <li class="page-item"><a class="page-link" href="@Url(Model.Pages)">@Model.Pages</a></li>
            }
            <li class="page-item @(Model.Page == Model.Pages ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page + 1)">›</a></li>
        </ul>
    }
</div>
