@model ElectroFix.Web.Models.ToIssuePage
@using System.Globalization
@{
    ViewData["Title"] = "Запчасти к выдаче";
}
<p class="text-muted">Здесь запчасти из согласованных смет, которые ещё не выдали мастеру. Выберите партию и выдайте — остаток спишется со склада.</p>
<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="p-4 text-center text-muted"><i class="bi bi-check2-circle fs-2 d-block text-success"></i>Всё выдано, ждать некому.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-light">
                <tr>
                    <th>Заказ-наряд</th>
                    <th>Запчасть</th>
                    <th class="text-end">Нужно / выдано</th>
                    <th style="min-width: 22rem">Выдать</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var i in Model.Items)
                {
                    var batches = Model.Batches.GetValueOrDefault(i.PartId, []).Where(b => b.Available > 0).ToList();
                    <tr>
                        <td class="text-nowrap">@i.WorkOrderNumber<div>@HtmlHelpers.Status(Labels.WorkOrderStatuses, i.WorkOrderStatus)</div></td>
                        <td>@i.PartName<div class="small text-muted">@i.Article</div></td>
                        <td class="text-end text-nowrap">@HtmlHelpers.Num(i.Needed) / @HtmlHelpers.Num(i.Issued) @i.Unit</td>
                        <td>
                            @if (batches.Count == 0)
                            {
                                <span class="text-danger small"><i class="bi bi-exclamation-triangle"></i> Нет на складе.</span>
                                <a asp-action="Receipt" asp-route-partId="@i.PartId" class="small">Оприходовать</a>
                            }
                            else
                            {
                                <form asp-action="Issue" method="post" class="d-flex flex-wrap gap-2">
                                    <input type="hidden" name="WorkOrderId" value="@i.WorkOrderId" />
                                    <input type="hidden" name="PartId" value="@i.PartId" />
                                    <select name="Batch" class="form-select form-select-sm w-auto" aria-label="Партия">
                                        @foreach (var b in batches)
                                        {
                                            <option value="@b.Batch">@b.Batch · @b.StorageCell · есть @HtmlHelpers.Num(b.Available)</option>
                                        }
                                    </select>
                                    <input name="Quantity" type="number" min="0.01" step="0.01" max="@i.Remaining.ToString(CultureInfo.InvariantCulture)"
                                           value="@i.Remaining.ToString(CultureInfo.InvariantCulture)" class="form-control form-control-sm" style="width: 6rem" aria-label="Количество" />
                                    <button class="btn btn-sm btn-success"><i class="bi bi-box-arrow-right"></i> Выдать</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
