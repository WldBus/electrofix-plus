@model PagedResult<StockMoveDto>
@{
    ViewData["Title"] = "Движения по складу";
    var q = (StockMoveListQuery)ViewBag.Query;
}
<div class="card">
    <form method="get" class="row g-2 p-3 border-bottom">
        <div class="col-12 col-md-5">
            <input name="search" value="@q.Search" class="form-control" placeholder="Артикул, запчасть, партия" />
        </div>
        <div class="col-7 col-md-4">
            <select name="moveType" class="form-select" data-autosubmit aria-label="Тип движения">
                <option value="">Все движения</option>
                @foreach (var (key, label) in Labels.MoveTypes)
                {
                    <option value="@key" selected="@(key == q.MoveType)">@label</option>
                }
            </select>
        </div>
        <input type="hidden" name="sort" value="@q.Sort" />
        <div class="col-5 col-md-3"><button class="btn btn-primary w-100"><i class="bi bi-search"></i> Найти</button></div>
    </form>
    @if (Model.Items.Count == 0)
    {
        <div class="p-4 text-center text-muted"><i class="bi bi-arrow-left-right fs-2 d-block"></i>Движений не найдено.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th>@Html.SortHeader("moved", "Когда")</th>
                    <th>@Html.SortHeader("type", "Операция")</th>
                    <th>Запчасть</th>
                    <th class="text-end">Кол-во</th>
                    <th class="d-none d-md-table-cell">Партия / ячейка</th>
                    <th class="d-none d-md-table-cell">Заказ-наряд</th>
                    <th class="d-none d-lg-table-cell">Кто</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap">@HtmlHelpers.Time(m.MovedAt)</td>
                        <td>@Labels.Of(Labels.MoveTypes, m.MoveType)</td>
                        <td>@m.PartName<div class="small text-muted">@m.Article</div></td>
                        <td class="text-end">@HtmlHelpers.Num(m.Quantity)</td>
                        <td class="d-none d-md-table-cell">@m.Batch@(m.StorageCell != null ? " · " + m.StorageCell : "")</td>
                        <td class="d-none d-md-table-cell">@(m.WorkOrderNumber ?? "–")</td>
                        <td class="d-none d-lg-table-cell">@m.PerformedBy</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="new PagerModel(Model.Page, Model.Size, Model.Total)" />
</div>
