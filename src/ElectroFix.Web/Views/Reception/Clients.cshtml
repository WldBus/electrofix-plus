@model PagedResult<ClientDto>
@{
    ViewData["Title"] = "Клиенты";
    var q = (ClientListQuery)ViewBag.Query;
}
<div class="card">
    <form method="get" class="row g-2 p-3 border-bottom">
        <div class="col-12 col-md-5">
            <input name="search" value="@q.Search" class="form-control" placeholder="ФИО, название, телефон, email, ИНН" autofocus />
        </div>
        <div class="col-7 col-md-3">
            <select name="clientType" class="form-select" data-autosubmit aria-label="Тип клиента">
                <option value="">Все типы</option>
                @foreach (var (key, label) in Labels.ClientTypes)
                {
                    <option value="@key" selected="@(key == q.ClientType)">@label</option>
                }
            </select>
        </div>
        <input type="hidden" name="sort" value="@q.Sort" />
        <div class="col-5 col-md-2"><button class="btn btn-primary w-100"><i class="bi bi-search"></i> Найти</button></div>
        <div class="col-12 col-md-2"><a asp-action="NewClient" class="btn btn-outline-primary w-100"><i class="bi bi-person-plus"></i> Новый</a></div>
    </form>
    @if (Model.Items.Count == 0)
    {
        <div class="p-4 text-center text-muted"><i class="bi bi-people fs-2 d-block"></i>Клиент не найден. <a asp-action="NewClient">Добавить нового</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th>@Html.SortHeader("name", "Клиент")</th>
                    <th>Телефон</th>
                    <th class="d-none d-md-table-cell">Email</th>
                    <th class="d-none d-sm-table-cell text-end">Устройств</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td>@c.DisplayName<div class="small text-muted">@Labels.Of(Labels.ClientTypes, c.ClientType)</div></td>
                        <td class="text-nowrap">@c.Phone</td>
                        <td class="d-none d-md-table-cell">@(c.Email ?? "–")</td>
                        <td class="d-none d-sm-table-cell text-end">@c.DevicesCount</td>
                        <td class="text-end"><a asp-action="Book" asp-route-clientId="@c.ClientId" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-calendar-plus"></i> Записать</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="new PagerModel(Model.Page, Model.Size, Model.Total)" />
</div>
