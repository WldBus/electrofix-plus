@model ElectroFix.Web.Models.OpenPage
@{
    ViewData["Title"] = "Приёмка устройства";
    var c = Model.Checkin;
}
<div class="row g-4">
    <div class="col-lg-5">
        <div class="card p-3">
            <h2 class="h5">Запись</h2>
            <dl class="row small mb-0">
                <dt class="col-5">Клиент</dt><dd class="col-7">@c.ClientName</dd>
                <dt class="col-5">Устройство</dt><dd class="col-7">@c.Device</dd>
                <dt class="col-5">Когда</dt><dd class="col-7">@HtmlHelpers.Time(c.SlotStart)</dd>
                <dt class="col-5">Филиал</dt><dd class="col-7">@c.Branch</dd>
                <dt class="col-5">Приоритет</dt><dd class="col-7">@Labels.Of(Labels.Priorities, c.Priority)</dd>
                <dt class="col-5">Неисправность</dt><dd class="col-7">@c.Defects</dd>
                <dt class="col-5">Пожелания</dt><dd class="col-7">@(c.ServicesRequested ?? "–")</dd>
                <dt class="col-5">Статус</dt><dd class="col-7">@HtmlHelpers.Status(Labels.CheckinStatuses, c.Status)</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card p-3 p-md-4">
            <h2 class="h5 mb-3">Осмотр при приёмке</h2>
            @if (c.Status != "confirmed")
            {
                <div class="alert alert-warning mb-0">Принять можно только подтверждённую запись. Сейчас: @Labels.Of(Labels.CheckinStatuses, c.Status).</div>
            }
            else
            {
                <form asp-action="Open" asp-route-id="@c.CheckinId" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Form.ConditionState" class="form-label">Внешнее состояние</label>
                        <textarea asp-for="Form.ConditionState" class="form-control" rows="3" placeholder="Царапины на корпусе, нет заглушки…"></textarea>
                        <span asp-validation-for="Form.ConditionState" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.RuntimeAtCheckin" class="form-label">Наработка, ч <span class="text-muted">(если есть счётчик)</span></label>
                        <input asp-for="Form.RuntimeAtCheckin" class="form-control" min="0" />
                        <span asp-validation-for="Form.RuntimeAtCheckin" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-success"><i class="bi bi-clipboard-plus"></i> Принять и открыть заказ-наряд</button>
                    <a asp-action="Index" class="btn btn-link">Назад</a>
                </form>
            }
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
