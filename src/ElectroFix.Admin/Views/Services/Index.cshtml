@model PagedResult<ServiceDto>
@{
    ViewData["Title"] = "Работы";
    var q = (CatalogListQuery)ViewBag.Query;
}
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
    <form method="get" class="d-flex flex-wrap gap-2">
        @if (q.Deleted)
        {
            <input type="hidden" name="deleted" value="true" />
        }
        <input name="search" value="@q.Search" class="form-control" placeholder="Наименование" style="width: 240px" />
        <input name="category" value="@q.Category" class="form-control" placeholder="Категория" style="width: 180px" />
        <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Добавить</a>
</div>
<partial name="_TrashTabs" model="q.Deleted" />
<div class="card rounded-top-0">
    <div class="p-2 border-bottom"><partial name="_BulkBar" model="q.Deleted" /></div>
    <div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
        <tr>
            <th style="width: 1px"><input type="checkbox" class="form-check-input" data-check-all /></th>
            <th>@Html.SortHeader("name", "Наименование")</th>
            <th>@Html.SortHeader("category", "Категория")</th>
            <th class="text-end">@Html.SortHeader("hours", "Норма, ч")</th>
            <th class="text-end">@Html.SortHeader("rate", "Ставка за час")</th>
            <th class="text-end">Стоимость</th>
            <th class="text-end">Гарантия</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Items)
        {
            <tr>
                <td><input type="checkbox" class="form-check-input" name="ids" value="@s.ServiceId" form="bulk" /></td>
                <td>@s.Name</td>
                <td>@s.Category</td>
                <td class="text-end">@HtmlHelpers.Num(s.NormHours)</td>
                <td class="text-end">@HtmlHelpers.Money(s.Rate)</td>
                <td class="text-end">@HtmlHelpers.Money(s.NormHours * s.Rate)</td>
                <td class="text-end">@s.WarrantyMonths мес.</td>
                <td class="text-end text-nowrap"><partial name="_RowActions" model="(s.ServiceId, s.DeletedAt != null, s.Name)" /></td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted py-3">Работы не найдены</td></tr>
        }
        </tbody>
    </table>
    </div>
    <partial name="_Pager" model="new PagerModel(Model.Page, Model.Size, Model.Total)" />
</div>
