@model PagedResult<WarrantyCaseDto>
@{
    ViewData["Title"] = "Гарантийные случаи";
    ViewData["ReadOnly"] = true;
    var q = (StatusListQuery)ViewBag.Query;
}
<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <input name="search" value="@q.Search" class="form-control" placeholder="Номер заказ-наряда или причина" style="width: 280px" />
    <select name="status" class="form-select w-auto" onchange="this.form.submit()">
        <option value="">Все решения</option>
        @foreach (var (code, label) in Labels.WarrantyDecisions)
        {
            <option value="@code" selected="@(q.Status == code)">@label</option>
        }
    </select>
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
</form>
<div class="card">
    <div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
        <tr>
            <th>@Html.SortHeader("created", "Создан")</th>
            <th>Заказ-наряд</th>
            <th>Причина</th>
            <th>Осмотр</th>
            <th>@Html.SortHeader("decision", "Решение")</th>
            <th class="text-end">Компенсация</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var w in Model.Items)
        {
            <tr>
                <td>@HtmlHelpers.Day(w.CreatedAt)</td>
                <td><a asp-controller="WorkOrders" asp-action="Details" asp-route-id="@w.WorkOrderId">@w.WorkOrderNumber</a></td>
                <td>@w.Reason</td>
                <td>@w.InspectionNotes</td>
                <td>@Labels.Of(Labels.WarrantyDecisions, w.Decision)</td>
                <td class="text-end">@HtmlHelpers.Money(w.SettlementAmount)</td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted py-3">Гарантийных случаев нет</td></tr>
        }
        </tbody>
    </table>
    </div>
    <partial name="_Pager" model="new PagerModel(Model.Page, Model.Size, Model.Total)" />
</div>
