@model PagedResult<ClientDto>
@{
    ViewData["Title"] = "Клиенты";
    var q = (ClientListQuery)ViewBag.Query;
}
@* ФИО частных клиентов админу приходят скрытыми, названия организаций — как есть *@
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
    <form method="get" class="d-flex flex-wrap gap-2">
        @if (q.Deleted)
        {
            <input type="hidden" name="deleted" value="true" />
        }
        <input name="search" value="@q.Search" class="form-control" placeholder="Наименование, телефон или ИНН" style="width: 280px" />
        <select name="clientType" class="form-select w-auto" onchange="this.form.submit()">
            <option value="">Все типы</option>
            @foreach (var (key, label) in Labels.ClientTypes)
            {
                <option value="@key" selected="@(q.ClientType == key)">@label</option>
            }
        </select>
        <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Добавить</a>
</div>
<partial name="_TrashTabs" model="q.Deleted" />
<div class="card rounded-top-0">
    <div class="p-2 border-bottom"><partial name="_BulkBar" model="q.Deleted" /></div>
    <div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
        <tr>
            <th style="width: 1px"><input type="checkbox" class="form-check-input" data-check-all /></th>
            <th>@Html.SortHeader("name", "Наименование / ФИО")</th>
            <th>@Html.SortHeader("type", "Тип")</th>
            <th>ИНН</th>
            <th>Телефон</th>
            <th>Email</th>
            <th class="text-end">Устройств</th>
            <th>@Html.SortHeader("created", "Добавлен")</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Items)
        {
            <tr>
                <td><input type="checkbox" class="form-check-input" name="ids" value="@c.ClientId" form="bulk" /></td>
                <td>@c.DisplayName</td>
                <td>@Labels.Of(Labels.ClientTypes, c.ClientType)</td>
                <td>@c.Inn</td>
                <td>@c.Phone</td>
                <td>@c.Email</td>
                <td class="text-end">
                    <a asp-controller="Devices" asp-action="Index" asp-route-clientId="@c.ClientId">@c.DevicesCount</a>
                </td>
                <td>@HtmlHelpers.Day(c.CreatedAt)</td>
                <td class="text-end text-nowrap"><partial name="_RowActions" model="(c.ClientId, c.DeletedAt != null, c.DisplayName)" /></td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="9" class="text-center text-muted py-3">Клиенты не найдены</td></tr>
        }
        </tbody>
    </table>
    </div>
    <partial name="_Pager" model="new PagerModel(Model.Page, Model.Size, Model.Total)" />
</div>
