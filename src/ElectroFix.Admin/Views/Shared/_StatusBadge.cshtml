@model string
@* цветная метка статуса заказ-наряда или счёта *@
@{
    // спокойные метки: светлый фон и тёмный текст того же цвета (в тёмной теме Bootstrap сам их приглушает)
    var tone = Model switch
    {
        "closed" or "paid" => "success",
        "cancelled" => "secondary",
        "ready" or "partially_paid" => "info",
        "unpaid" or "estimate" => "warning",
        "in_progress" or "assigned" or "pdi" => "primary",
        _ => "secondary",
    };
    var css = $"bg-{tone}-subtle text-{tone}-emphasis border border-{tone}-subtle";
    var label = Labels.WorkOrderStatuses.ContainsKey(Model)
        ? Labels.Of(Labels.WorkOrderStatuses, Model)
        : Labels.Of(Labels.InvoiceStatuses, Model);
}
<span class="badge @css">@label</span>
