@{
    ViewData["Title"] ??= "Ошибка";
    var retry = ViewData["RetryUrl"] as string;
}
@* сюда попадаю, если Api или сервис статистики не ответил или вернул ошибку *@
<div class="card p-4" style="max-width: 640px">
    <div class="d-flex gap-3">
        <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
        <div>
            <p class="mb-3">@(ViewData["Message"] ?? "Что-то пошло не так. Попробуйте ещё раз.")</p>
            @if (retry != null)
            {
                <a href="@retry" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i> Повторить</a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-link">На главную</a>
        </div>
    </div>
</div>
