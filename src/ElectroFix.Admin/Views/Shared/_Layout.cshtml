@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) =>
        controller == c && (a == null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="ru" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – ElectroFix+ Админ-панель</title>
    @* тема как на сайте: выбранная вручную или как в системе. Ставлю до стилей, чтобы не мигало *@
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('ef-theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') {
                t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="layout d-flex">
        <div class="topbar">
            <a class="brand" asp-controller="Home" asp-action="Index">ElectroFix+</a>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar"
                    aria-controls="sidebar" aria-expanded="false"><i class="bi bi-list"></i> Меню</button>
        </div>
        <nav id="sidebar" class="sidebar collapse d-lg-flex flex-column" aria-label="Разделы админ-панели">
            <a class="brand mb-2" asp-controller="Home" asp-action="Index">
                ElectroFix+
                <small>Администрирование БД</small>
            </a>
            <ul class="nav flex-column">
                <li class="nav-section">Статистика</li>
                <li><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Обзор</a></li>
                <li><a class="nav-link @Active("Security")" asp-controller="Security" asp-action="Index"><i class="bi bi-shield-lock"></i> Безопасность</a></li>
                <li class="nav-section">Администрирование</li>
                <li><a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-badge"></i> Пользователи и роли</a></li>
                <li><a class="nav-link @Active("Reports", "Audit")" asp-controller="Reports" asp-action="Audit"><i class="bi bi-journal-text"></i> Журнал аудита</a></li>
                <li class="nav-section">Клиенты и устройства</li>
                <li><a class="nav-link @Active("Requests")" asp-controller="Requests" asp-action="Index"><i class="bi bi-envelope-paper"></i> Заявки с сайта</a></li>
                <li><a class="nav-link @Active("Clients")" asp-controller="Clients" asp-action="Index"><i class="bi bi-people"></i> Клиенты</a></li>
                <li><a class="nav-link @Active("Devices")" asp-controller="Devices" asp-action="Index"><i class="bi bi-phone"></i> Устройства</a></li>
                <li class="nav-section">Справочники</li>
                <li><a class="nav-link @Active("Services")" asp-controller="Services" asp-action="Index"><i class="bi bi-tools"></i> Работы</a></li>
                <li><a class="nav-link @Active("Parts")" asp-controller="Parts" asp-action="Index"><i class="bi bi-cpu"></i> Запчасти</a></li>
                <li class="nav-section">Приёмка и ремонт</li>
                <li><a class="nav-link @Active("Checkins")" asp-controller="Checkins" asp-action="Index"><i class="bi bi-calendar-check"></i> Приёмки</a></li>
                <li><a class="nav-link @Active("WorkOrders")" asp-controller="WorkOrders" asp-action="Index"><i class="bi bi-clipboard-check"></i> Заказ-наряды</a></li>
                <li class="nav-section">Склад и финансы</li>
                <li><a class="nav-link @Active("Reports", "Stock")" asp-controller="Reports" asp-action="Stock"><i class="bi bi-box-seam"></i> Остатки</a></li>
                <li><a class="nav-link @Active("Reports", "StockMoves")" asp-controller="Reports" asp-action="StockMoves"><i class="bi bi-arrow-left-right"></i> Движения</a></li>
                <li><a class="nav-link @Active("Reports", "Invoices")" asp-controller="Reports" asp-action="Invoices"><i class="bi bi-receipt"></i> Счета</a></li>
                <li><a class="nav-link @Active("Reports", "Payments")" asp-controller="Reports" asp-action="Payments"><i class="bi bi-cash-coin"></i> Платежи</a></li>
                <li><a class="nav-link @Active("Reports", "Warranty")" asp-controller="Reports" asp-action="Warranty"><i class="bi bi-shield-check"></i> Гарантия</a></li>
            </ul>
            <div class="sidebar-foot mt-auto">
                <div class="who">Вы вошли как</div>
                <div class="name" title="@User.Identity.Name">@User.Identity.Name</div>
                <div class="d-flex gap-2">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="flex-grow-1">
                        <button class="btn btn-sm btn-outline-secondary w-100"><i class="bi bi-box-arrow-right"></i> Выйти</button>
                    </form>
                    <button type="button" class="btn ef-theme-btn" data-theme-toggle aria-label="Переключить тему" title="Переключить тему">
                        <i class="bi bi-moon ef-if-light"></i><i class="bi bi-sun ef-if-dark"></i>
                    </button>
                </div>
            </div>
        </nav>
        <main class="flex-grow-1 p-4">
            <h1 class="page-title">
                @ViewData["Title"]
                @if (ViewData["ReadOnly"] is true)
                {
                    <span class="readonly-mark"><i class="bi bi-eye"></i> только просмотр</span>
                }
            </h1>
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show">@ok
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button></div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show">@err
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button></div>
            }
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
